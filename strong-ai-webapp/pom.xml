    <modelVersion>4.0.0</modelVersion>
    <version>1.0-SNAPSHOT</version>

    <artifactId>strong-ai-webapp</artifactId>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <!--    webapp模块不需要deploy    -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>cn.strong</groupId>
            <artifactId>strong-webapp-base</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.strong.webapp</groupId>
            <artifactId>strong-ai-model</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.strong.webapp</groupId>
            <artifactId>strong-ai-mq-model</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.strong.webapp</groupId>
            <artifactId>strong-ai-remote-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--log4j2 依赖-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lmax</groupId>
            <artifactId>disruptor</artifactId>
        </dependency>

        <!--naco配置中心和注册中心-->
        <dependency>
            <groupId>cn.strong</groupId>
            <artifactId>nacos-extend-spring-cloud-starter</artifactId>
            <version>2023.1-SNAPSHOT</version>
        </dependency>

        <!-- openFeign 远程调用相关 具体属性配置参考 https://docs.spring.io/spring-cloud-openfeign/docs/3.0.0/reference/html/-->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- 添加 httpclient 框架依赖 -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-httpclient</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>


